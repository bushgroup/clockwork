.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.claude/
CLAUDE.local.md
# Build output.
dist/
build/
*.egg-info/
# No acquisition ever enters the code repo: sample files live in the lab repo,
# and the pre-commit hook refuses the path as well.
*.uimf
*.uimf-journal
*.uimf-wal
*.uimf-shm
# Vendor manuals (GAA Custom Electronics PDFs) are proprietary and live in the
# lab repo's vendor/. Only facts derived from them are committed here, in docs/.
*.pdf
# tools/write_commit.py's build-time output: the commit a frozen .exe was built from,
# written before every build and never tracked. A checkout has none and answers None.
src/clockwork/_commit.py
# tools/warm_numba_cache.py's build-time output, bundled into the .exe by
# packaging/clockwork.spec; regenerated before every build, never tracked.
packaging/numba_cache_seed/
# tools/stage_console.py's build-time output: the acquisition console's exe, DLLs,
# config.txt and app.h, copied from a lab-side build; regenerated before every build,
# never tracked (lab record, task 52).
packaging/console_payload/
